MONGO_URI=mongodb://127.0.0.1:27017/unihome
MONGO_DB=UniHome
# Enable only if your network blocks MongoDB SRV/TXT DNS queries.
MONGO_DNS_OVER_HTTPS=false
PORT=3000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
# Optional: configured credentials send new room images to Cloudinary.
# Keep the API secret only on the backend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
